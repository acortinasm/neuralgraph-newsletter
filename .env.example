# NeuralGraph Newsletter Configuration

# NeuralGraphDB Connection
NEURALGRAPH_URL=http://localhost:3000

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here

# Email Settings
FROM_EMAIL=Newsletter <newsletter@yourdomain.com>

# Public URL (for tracking links)
BASE_URL=https://yourdomain.com

# Debug Mode (enables query logging, permissive CORS)
DEBUG=false

# CORS (comma-separated origins, leave empty to use DEBUG setting)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Security
SECRET_KEY=change-this-to-a-secure-random-string

# Token Settings
TOKEN_EXPIRE_DAYS=7

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_API_KEY=  # Legacy: single API key. Use POST /auth/api-key for DB-stored keys

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Logging
LOG_FORMAT=json      # json or text
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR
